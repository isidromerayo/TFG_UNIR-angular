/* TypeScript configuration for Cypress specs, typechecked in `pnpm run verify`.
   Component testing is disabled on Angular 22 (@cypress/webpack-dev-server
   incompatibility), so cypress/component and cypress/support/component.ts are
   excluded: @cypress/angular is not installed and would break this check. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/cypress",
    "rootDir": "./",
    "types": [
      "cypress",
      "jasmine",
      "node"
    ],
    "lib": [
      "ES2022",
      "dom"
    ]
  },
  "include": [
    "src/**/*.ts",
    "cypress/e2e/**/*.cy.ts",
    "cypress/support/e2e.ts",
    "cypress/support/commands.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.spec.ts"
  ]
}
