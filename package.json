{
  "name": "frontend-angular",
  "version": "0.3.0",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test-headless": "ng test --watch=false --browsers=ChromeHeadless",
    "test-headless-cc": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "e2e": "ng e2e",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:component": "cypress run --component",
    "cypress:component:open": "cypress open --component",
    "cypress:coverage": "CYPRESS_COVERAGE=true cypress run --component",
    "cypress:component:coverage": "CYPRESS_COVERAGE=true cypress run --component",
    "cypress:component:coverage:open": "CYPRESS_COVERAGE=true cypress open --component",
    "cypress:e2e:coverage": "CYPRESS_COVERAGE=true cypress run --e2e",
    "security": "./scripts/security-check.sh",
    "security:accepted": "./scripts/check-accepted-advisories.sh",
    "security:audit": "pnpm audit",
    "security:outdated": "pnpm outdated",
    "a11y": "pa11y-ci",
    "verify": "pnpm run test-headless && pnpm run build && pnpm audit --prod",
    "precommit": "pnpm run verify",
    "lint": "eslint src/**/*.ts src/**/*.html",
    "lint:fix": "eslint src/**/*.ts src/**/*.html --fix"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@sweetalert2/ngx-sweetalert2": "^15.0.1",
    "axios": "^1.20.0",
    "form-data": "^4.0.6",
    "rxjs": "~7.8.0",
    "sweetalert2": "11.26.25",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@cypress/angular": "^5.0.0",
    "@cypress/code-coverage": "^4.1.2",
    "@cypress/schematic": "^6.0.0",
    "@cypress/webpack-dev-server": "^6.1.2",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/jasmine": "~5.1.15",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "ajv": "^8.20.0",
