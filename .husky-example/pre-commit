# Bloqueo de commits directos a main/master
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "ERROR: commits directos a '$branch' no están permitidos." >&2
  echo "Crea una rama (feature/, fix/, chore/, ...) y abre un PR." >&2
  exit 1
fi

#!/bin/sh
# Pre-commit hook example
# To use: npm install husky --save-dev && npx husky install

echo "🔍 Running pre-commit checks..."

# Run tests
echo "📝 Running tests..."
pnpm run test-headless
if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Commit aborted."
  exit 1
fi

# Run build
echo "🔨 Running build..."
pnpm run build
if [ $? -ne 0 ]; then
  echo "❌ Build failed. Commit aborted."
  exit 1
fi

# Run audit
echo "🔒 Running security audit..."
pnpm audit
if [ $? -ne 0 ]; then
  echo "⚠️  Security vulnerabilities found. Please review."
fi

echo "✅ All checks passed!"
exit 0
